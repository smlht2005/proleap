*>會診回覆(新增)----計算會診費 住院
************************************************************************
 F-CHK-WRT-ICA.
        INITIALIZE W-NOTE.
        MOVE "會診費計價中....請勿按中斷鍵...." TO W-NOTE.
        PERFORM F-WAR-NOTE.
        INITIALIZE W-LNK-METCF NID-MST-REC.
        INITIALIZE W-RSO-DPT W-RSO-COUNT.
        MOVE "0501"     TO NID-ID.
        MOVE MET-DPT    TO NID-CODE.
        READ NID-MST KEY IS NID-MST-KEY.
        MOVE NID-MST-REC(25:2)  TO W-RSO-DPT.
        MOVE NID-MST-REC(290:9) TO W-METCF-FEE-KEY.
*> 若無登記會診費處置代碼則無法產生會診費
        IF W-METCF-FEE-KEY = SPACE THEN
                INITIALIZE W-NOTE
                MOVE "科別尚未設定會診費處置代碼，請聯絡資訊室！" TO W-NOTE
                PERFORM F-ERR-NOTE
                GO TO F-CHK-WRT-EXIT
        END-IF.
        INITIALIZE RSO-SON-REC.

        MOVE "a"        TO RSO-ID.
        MOVE IPD-NO     TO RSO-A1-IPD-NO.
        START RSO-SON KEY IS NOT < RSO-SON-KEY.
        READ RSO-SON NEXT RECORD.
        MOVE "Y"        TO W-RSO-CHK.
        PERFORM VARYING W-RSO-II FROM 1 BY 1 UNTIL RSO-SON-STATUS NOT = "00"
                OR RSO-ID NOT = "a" OR RSO-A1-IPD-NO NOT = IPD-NO
                ADD 1 TO W-RSO-COUNT
*>              找到相同之科別
                IF RSO-A1-DPT = W-RSO-DPT AND W-RSO-DPT NOT = SPACE
                   AND W-NID-1198(149:1) NOT = "Y" THEN
                        MOVE "N"        TO W-RSO-CHK
                END-IF
                READ RSO-SON NEXT RECORD
        END-PERFORM.
*>      若超過可以計算之範圍是否以自費計
        MOVE MET-DPT    TO W-METCF-DPT.
        MOVE MET-ANS-DR TO W-METCF-DR-NO.
        IF W-RSO-CHK = "N" OR (W-RSO-COUNT >= W-RSO-TIME AND W-RSO-COUNT > 0) THEN
*>              看參數自費患者可不限制會診計價次數
                PERFORM F-GET-INSU-ID
                IF W-NID-1198(244:1) = "Y" AND W-INSU-ID NOT = "1" THEN
                        MOVE "Y"        TO W-METCF-PAY
                ELSE
*>                      自費
                        IF W-NID-1198(98:1) = "Y" THEN
                                MOVE "Y"        TO W-METCF-PAY
                                MOVE "Y"        TO W-METCF-PAY2
*>                      不計價
                        ELSE
                                MOVE "N"        TO W-METCF-PAY
                        END-IF
                END-IF
        ELSE
*>              若尚未超過則自行計價
                MOVE "Y"        TO W-METCF-PAY
        END-IF.
*>      同科會同科一律以不計價算(大科別)
        IF W-IPD-DPT = W-RSO-DPT THEN
                MOVE "N"        TO W-METCF-PAY
        END-IF.
*>      97.5.30 會診次數
        PERFORM F-HICNTCF-RTN THRU F-HICNTCF-EXIT.
*>START (AICE) 101.06.29 DM1201-J1201172 寫入執行人員及執行日期
*>      執行日期
        MOVE W-MET-DT   TO W-METCF-RUN-DT.
*
*>      920503暫時將HRMETCF  MARK起來....因為HI的訊息未改完成
        CALL "HRMETCF" USING W-RUN-CHK W-LNK-METCF ON EXCEPTION CONTINUE.
        CANCEL "HRMETCF".
        IF W-METCF-RETURN-CODE = 99 THEN
                INITIALIZE W-NOTE
                MOVE W-METCF-NOTE TO W-NOTE
                PERFORM F-ERR-NOTE
        ELSE
                INITIALIZE W-NOTE
                MOVE "會診費計價完成！！" TO W-NOTE

                PERFORM F-ERR-NOTE
                IF W-METCF-PAY = "Y" THEN
                        INITIALIZE RSO-SON-REC
                        MOVE "a"                TO RSO-ID
                        MOVE IPD-NO             TO RSO-A1-IPD-NO
                        MOVE W-METCF-DPT        TO RSO-A1-DPT
                        MOVE W-METCF-ICA        TO RSO-A1-ODR-NO
                        MOVE MET-NOT-NO         TO RSO-A1-MET-NO
                        WRITE RSO-SON-REC
                END-IF
        END-IF.
 F-CHK-WRT-EXIT.
        EXIT.

                        MOVE "N"                TO W-HRMESCF-BUT-VALUE(2)
                        MOVE "是"               TO W-HRMESCF-BUT-NAME(1)
                        MOVE "否"               TO W-HRMESCF-BUT-NAME(2)
                        CALL "HRMESCF" USING W-HRMESCF-DATA W-HRMESCF-DATA2 ON EXCEPTION CONTINUE
                        END-CALL
                        IF W-HRMESCF-RETURN = "N" THEN

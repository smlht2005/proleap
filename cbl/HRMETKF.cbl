        START MET-MST KEY IS NOT < MET-ALT-KEY2.
*>      2024/11/26 桃園-因為EXTERNAL過多導致CALL程式無法叫起來，所以減少EXTERNAL數量
*>      沒有使用了所以先MARK
*>      INITIALIZE A4GL-WHERE-CONSTRAINT.
*>      2024/11/26 END
        READ MET-MST NEXT RECORD.
        IF MET-MST-STATUS NOT = "00" OR MET-SYS-ID NOT = W-MET-SYS-ID OR
           MET-DT NOT = 0 THEN
                INITIALIZE W-NOTE
                MOVE "目前無任何待回覆會診資料，請確定！"       TO W-NOTE
                PERFORM F-ERR-NOTE
                INITIALIZE MET-MST-REC MEL-MST-REC
                MOVE "N"        TO W-MET-DATA-CHK
        END-IF.
 F-FIND-MET-DATA1.
        INITIALIZE MET-MST-REC.
        MOVE W-MET-SYS-ID       TO MET-SYS-ID.
        MOVE W-TMP-IPD-NO       TO MET-IPD-NO.
        START MET-MST KEY IS NOT < MET-MST-KEY.
*>      2024/11/26 桃園-因為EXTERNAL過多導致CALL程式無法叫起來，所以減少EXTERNAL數量
*>      沒有使用了所以先MARK
*>        INITIALIZE A4GL-WHERE-CONSTRAINT.
*>      2024/11/26 END
        READ MET-MST NEXT RECORD.
        IF MET-MST-STATUS NOT = "00" OR MET-IPD-NO(1:11) NOT = W-TMP-IPD-NO
           OR MET-SYS-ID NOT = W-MET-SYS-ID THEN
                INITIALIZE W-NOTE
                MOVE "此病患尚無任何會診相關資料，請確定！"     TO W-NOTE
                PERFORM F-ERR-NOTE
                INITIALIZE MET-MST-REC MEL-MST-REC
                MOVE "N"        TO W-MET-DATA-CHK
        ELSE
                IF W-SEL = "2" AND W-JOB = "1" THEN
                        PERFORM F-READ-MET-NEXT
                        IF MET-MST-STATUS NOT = "00" OR MET-SYS-ID NOT = W-MET-SYS-ID
                           OR W-TMP-IPD-NO NOT = MET-IPD-NO(1:11) THEN
                                INITIALIZE W-NOTE
                                MOVE "此病患尚無任何未回覆之資料，請使用修改功能！"     TO W-NOTE
                                PERFORM F-ERR-NOTE
                                INITIALIZE MET-MST-REC MEL-MST-REC
                                MOVE "N"        TO W-MET-DATA-CHK
                        END-IF
                ELSE
                        IF W-SEL = "2" AND (W-JOB = "2" OR "3") THEN
                                PERFORM F-READ-MET-NEXT
                                IF MET-MST-STATUS NOT = "00" OR MET-SYS-ID NOT = W-MET-SYS-ID
                                   OR W-TMP-IPD-NO NOT = MET-IPD-NO(1:11) THEN
                                        INITIALIZE W-NOTE
                                        MOVE "此病患尚無任何已回覆之資料，請使用新增功能！"     TO W-NOTE

                                        PERFORM F-ERR-NOTE
                                        INITIALIZE MET-MST-REC MEL-MST-REC
                                        MOVE "N"        TO W-MET-DATA-CHK
                                END-IF
                        END-IF
                END-IF
        END-IF.

 F-READ-MET-NEXT.
        IF W-SEL = "1" THEN
                READ MET-MST NEXT RECORD
        ELSE
                IF W-JOB = "1"
                        PERFORM VARYING W-FIND-KK FROM 1 BY 1 UNTIL MET-MST-STATUS NOT = "00"
                                OR (MET-MST-STATUS = "00" AND MET-ANS-DR = SPACE
                                AND MET-SYS-ID = W-MET-SYS-ID) OR MET-SYS-ID NOT = W-MET-SYS-ID
                                READ MET-MST NEXT RECORD
                        END-PERFORM
                ELSE
                        PERFORM VARYING W-FIND-KK FROM 1 BY 1 UNTIL MET-MST-STATUS NOT = "00"
                                OR (MET-MST-STATUS = "00" AND MET-ANS-DR NOT = SPACE
                                AND MET-SYS-ID = W-MET-SYS-ID) OR MET-SYS-ID NOT = W-MET-SYS-ID
                                READ MET-MST NEXT RECORD
                        END-PERFORM
                END-IF
        END-IF.

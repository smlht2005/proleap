*>START (AICE) 100.07.25
 F-CHK-NID-11B9-RTN.
        INITIALIZE W-CHK-YN.
        INITIALIZE NID-MST-REC.
        MOVE "1022"     TO NID-ID.
        MOVE W-DR       TO NID-CODE(1:4).
        MOVE W-DPT      TO NID-CODE(5:4).
        READ NID-MST KEY IS NID-MST-KEY.
        IF NID-MST-STATUS = "00" THEN
                EXIT PARAGRAPH
        END-IF.
*>      不審會診科別對應檔則直接離開
        IF W-NID-11A1(154:1) NOT = "Y" THEN
                MOVE "N"        TO W-CHK-YN
                EXIT PARAGRAPH
        END-IF.

*>      以下開始審會診科別對應檔
        INITIALIZE NID-MST-REC.
        MOVE "11B9"             TO NID-ID.
        MOVE W-DPT              TO NID-CODE(1:4).
        MOVE W-NID-0503(25:4)   TO NID-CODE(5:4).
        READ NID-MST KEY IS NID-MST-KEY.
        IF NID-MST-STATUS = "00" THEN
                EXIT PARAGRAPH
        END-IF.

        INITIALIZE NID-MST-REC.
        MOVE "11B9"             TO NID-ID.
        MOVE W-DPT              TO NID-CODE(1:4).
        MOVE W-NID-0503(184:4)  TO NID-CODE(5:4).
        READ NID-MST KEY IS NID-MST-KEY.
        IF NID-MST-STATUS = "00" THEN
                EXIT PARAGRAPH
        END-IF.

        INITIALIZE NID-MST-REC W-DPT-REC.
        MOVE "11B9"             TO NID-ID.
        MOVE W-DPT              TO NID-CODE(1:4).
        START NID-MST KEY IS NOT < NID-MST-KEY.
        READ NID-MST NEXT RECORD.
        PERFORM VARYING II FROM 1 BY 1
                UNTIL   NID-MST-STATUS NOT = "00" OR
                        NID-ID NOT = "11B9" OR
                        NID-CODE(1:4) NOT = W-DPT OR
                        II > 10
                MOVE NID-CODE(5:4)      TO W-DPT-CODE(II)
                READ NID-MST NEXT RECORD
        END-PERFORM.

        PERFORM VARYING II FROM 1 BY 1
                UNTIL II > 10 OR W-DPT-CODE(II) = SPACE
                INITIALIZE NID-MST-REC
                MOVE "1022"             TO NID-ID
                MOVE W-DR               TO NID-CODE(1:4)

                MOVE W-DPT-CODE(II)     TO NID-CODE(5:4)
                READ NID-MST KEY IS NID-MST-KEY
                IF NID-MST-STATUS = "00" THEN
                        EXIT PARAGRAPH
                END-IF
        END-PERFORM.

        MOVE "N"        TO W-CHK-YN.

 F-CHK-NID-11B9-EXIT.
        EXIT.

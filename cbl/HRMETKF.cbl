        MOVE W-TIME(1:6)        TO HROLA-MOD-TIME.
*>      異動者
        MOVE W-RUN-USID TO HROLA-MOD-USR-NO.
        IF W-SEL = "1" THEN
                MOVE "S" TO HROLA-MET-MET-ID
                EVALUATE W-JOB
                        WHEN "1"
                                MOVE "C"        TO HROLA-MOD-TYPE
                        WHEN "2"
                                MOVE "M"        TO HROLA-MOD-TYPE
                        WHEN "3"
                                MOVE "D"        TO HROLA-MOD-TYPE
                END-EVALUATE
        ELSE
                MOVE "R" TO HROLA-MET-MET-ID
                EVALUATE W-JOB
                        WHEN "1"
                                MOVE "C"        TO HROLA-MOD-TYPE
                        WHEN "2"
                                MOVE "M"        TO HROLA-MOD-TYPE
                        WHEN "3"
                                MOVE "D"        TO HROLA-MOD-TYPE
                END-EVALUATE
        END-IF.

*>START (AICE) 98.03.30 存檔時增加判斷會診回覆日期時間須大於會診通知日期時間
        COMPUTE W-MET-DATI-1 = (W-MET-DATE * 10000) + (W-NOT-HH * 100) + W-NOT-MM.
        COMPUTE W-MET-DATI-2 = (W-MET-DT * 10000) + (W-MET-HH * 100) + W-MET-MM.
*>START (AICE) 98.08.03 增加系統識別
        IF (W-MET-SYS-ID = "I" AND W-MET-DT < IPD-DT) OR
           (W-MET-DATI-1 > W-MET-DATI-2) THEN
                MOVE "Y"        TO W-CHK-DATA


                EVALUATE TRUE
                        WHEN (W-MET-DT < W-MET-DATE)
                                MOVE 315        TO W-CONTROL-ID
                        WHEN (W-MET-HH < W-NOT-HH)
                                MOVE 316        TO W-CONTROL-ID
                        WHEN (W-MET-MM < W-NOT-MM)
                                MOVE 319        TO W-CONTROL-ID
                END-EVALUATE

                MOVE "會診日期時間須大於會診申請日期時間"       TO W-NOTE
        ELSE
                IF ((W-RUN-HIDID = "LS") AND
                    (W-NID-11B0(175:1) = "Y")) THEN
                        CONTINUE
                ELSE
                        IF (W-MET-SYS-ID = "I" AND
                            IPD-OUT-DT > 0 AND
                            W-MET-DT > IPD-OUT-DT) THEN
                                MOVE "Y"        TO W-CHK-DATA
                                MOVE 315        TO W-CONTROL-ID
                                MOVE "會診日期不可大於出院日期" TO W-NOTE
                        END-IF

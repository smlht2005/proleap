*
        INITIALIZE W-STP-TBL.
        MOVE "C" TO W-STP-DISK.
        IF W-RUN-PTH2(02) = SPACE THEN
                ACCEPT W-RUN-PTH2(02) FROM ENVIRONMENT "ZS_SCMS"
        END-IF.
        IF W-RUN-PTH2(02) NOT = SPACE THEN
                MOVE W-RUN-PTH2(02) TO W-STP-PFIX
                MOVE "Y"            TO W-STP-FSOK
                MOVE 02             TO W-RUN-SOCC
                SET ENVIRONMENT "FILE_PREFIX" TO W-RUN-PTH2(02)

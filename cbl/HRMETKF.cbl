                        MOVE "C"                TO W-HRMESCF-BUT-TYPE
                        MOVE "Y"                TO W-HRMESCF-CONTROL-ID
                        MOVE "[Y]存檔(重選病人) [C]存檔(不重選病人) [M]再修改 [N]放棄存檔"      TO W-HRMESCF-NOTE(3)
                        MOVE "Y"                TO W-HRMESCF-BUT-VALUE(1)
                        MOVE "存檔重選"         TO W-HRMESCF-BUT-NAME(1)
                        MOVE "C"                TO W-HRMESCF-BUT-VALUE(2)
                        MOVE "存檔不重選"       TO W-HRMESCF-BUT-NAME(2)
                        MOVE "M"                TO W-HRMESCF-BUT-VALUE(3)
                        MOVE "再修改"           TO W-HRMESCF-BUT-NAME(3)
                        MOVE "N"                TO W-HRMESCF-BUT-VALUE(4)
                        MOVE "放棄"             TO W-HRMESCF-BUT-NAME(4)
                ELSE
                        MOVE "6"                TO W-HRMESCF-BUT-TYPE
                        MOVE "Y"                TO W-HRMESCF-CONTROL-ID
                END-IF
                CALL "HRMESCF" USING W-HRMESCF-DATA W-HRMESCF-DATA2 ON EXCEPTION CONTINUE
                END-CALL

                IF W-HRMESCF-RETURN = "N" THEN
                        INITIALIZE W-HRMESCF-DATA W-HRMESCF-DATA2
                        MOVE "2"                TO W-HRMESCF-PIC-TYPE
                        MOVE "A"                TO W-HRMESCF-BUT-TYPE
                        MOVE "Y"                TO W-HRMESCF-CONTROL-ID

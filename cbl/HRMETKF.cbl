                        MOVE W-NID-0839(73:4) TO W-0839-IP-DPT
                END-IF
        END-IF.


        IF W-0839-IP-DPT = SPACE OR LOW-VALUE THEN
                EXIT PARAGRAPH
        END-IF.

        INITIALIZE W-IO-0838-YN.
        INITIALIZE NID-MST-REC W-NID-0838.
        MOVE "0838"     TO NID-ID.
        MOVE "B"        TO NID-CODE.
        READ NID-MST KEY IS NID-MST-KEY.
        IF NID-MST-STATUS = "00" THEN
                MOVE NID-MST-REC        TO W-NID-0838
        ELSE
                INITIALIZE NID-MST-REC
                MOVE "0838"             TO NID-ID
                MOVE "2"                TO NID-CODE(1:1)
                MOVE W-0839-IP-DPT      TO NID-CODE(2:4)
                MOVE W-AS-DATE          TO NID-CODE(6:7)
                READ NID-MST KEY IS NID-MST-KEY
                IF (NID-MST-STATUS = "00") AND
                   (NID-MST-REC(69:5) NOT =SPACE AND LOW-VALUE) THEN
                        MOVE NID-MST-REC(69:4) TO W-0838-SEND-IP-MAN
                        MOVE "Y"        TO  W-IO-0838-YN
                END-IF
                EXIT PARAGRAPH
        END-IF.
*
        PERFORM, WITH TEST BEFORE, VARYING W-0838-CNT FROM 1 BY 1,
                UNTIL  W-IO-0838-YN = "Y" OR W-0838-CNT > 3
                INITIALIZE W-0838-BEG-TIME W-0838-END-TIME W-0838-SCD-DATE
                INITIALIZE W-IO-TIME-YN
                EVALUATE W-0838-CNT
                        WHEN 1
                                IF W-NID-0838(84:1) = "Y" THEN
                                        MOVE W-NID-0838(085:4) TO W-0838-BEG-TIME WITH CONVERT
                                        MOVE W-NID-0838(089:4) TO W-0838-END-TIME WITH CONVERT
                                END-IF
                        WHEN 2
                                IF W-NID-0838(93:1) = "Y" THEN
                                        MOVE W-NID-0838(094:4) TO W-0838-BEG-TIME WITH CONVERT
                                        MOVE W-NID-0838(098:4) TO W-0838-END-TIME WITH CONVERT
                                END-IF
                        WHEN 3
                                IF W-NID-0838(102:1) = "Y" THEN
                                        MOVE W-NID-0838(103:4) TO W-0838-BEG-TIME WITH CONVERT
                                        MOVE W-NID-0838(107:4) TO W-0838-END-TIME WITH CONVERT
                                END-IF
                END-EVALUATE
                IF ((W-0838-BEG-TIME > 0) OR (W-0838-END-TIME > 0)) THEN
*>                      結束時間小於開始時間表示跨天
                        IF W-0838-END-TIME < W-0838-BEG-TIME THEN
                                IF (W-AS-TIME NOT < W-0838-END-TIME) AND
                                   (W-AS-TIME NOT > W-0838-BEG-TIME) THEN
                                        INITIALIZE W-IO-TIME-YN
                                ELSE
                                        IF W-AS-TIME < W-0838-END-TIME THEN
                                                INITIALIZE W-DATEC W-DATED W-DATER

                                                MOVE W-AS-DATE  TO W-DATEC

                                                MOVE 1          TO W-DATED
                                                CALL "ZDST5CF" USING W-DATEC W-DATED W-DATER
                                                        ON EXCEPTION CONTINUE
                                                END-CALL
                                                CANCEL "ZDST5CF"
                                                MOVE W-DATER    TO W-0838-SCD-DATE
                                                MOVE "Y"        TO W-IO-TIME-YN
                                        ELSE
                                                MOVE W-AS-DATE  TO W-0838-SCD-DATE
                                                MOVE "Y"        TO W-IO-TIME-YN
                                        END-IF
                                END-IF
                        ELSE
                                IF (W-AS-TIME NOT < W-0838-BEG-TIME)
                                AND (W-AS-TIME NOT > W-0838-END-TIME)
                                        MOVE W-AS-DATE  TO W-0838-SCD-DATE
                                        MOVE "Y"        TO W-IO-TIME-YN
                                END-IF
                        END-IF
                        IF W-IO-TIME-YN = "Y" THEN
                                INITIALIZE NID-MST-REC
                                MOVE "0838"             TO NID-ID
                                MOVE "2"                TO NID-CODE(1:1)
                                MOVE W-0839-IP-DPT      TO NID-CODE(2:4)
                                MOVE W-0838-SCD-DATE    TO NID-CODE(6:7)
                                READ NID-MST KEY IS NID-MST-KEY
                                IF NID-MST-STATUS = "00" THEN
                                        EVALUATE W-0838-CNT
                                                WHEN 1
                                                        MOVE NID-MST-REC(69:4) TO W-0838-SEND-IP-MAN
                                                WHEN 2
                                                        MOVE NID-MST-REC(74:4) TO W-0838-SEND-IP-MAN
                                                WHEN 3
                                                        MOVE NID-MST-REC(79:4) TO W-0838-SEND-IP-MAN
                                        END-EVALUATE
                                END-IF
                                MOVE "Y"        TO  W-IO-0838-YN
                        END-IF
                END-IF
        END-PERFORM.
 F-READ-NID-0839-EXIT.
        EXIT.


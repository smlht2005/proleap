 F-COMPUTE-LINE.
        INITIALIZE W-CNT,MDS-MST-REC,W-NOTD-TBL.
        IF MDL-ID = SPACE AND MDL-FROM = SPACE
                AND MDL-USE = SPACE AND MDL-CODE = SPACE THEN
                EXIT PARAGRAPH
        END-IF.
        MOVE MDL-ID TO MDS-ID.
        MOVE MDL-FROM TO MDS-FROM.
        MOVE MDL-USE TO MDS-USE.
        MOVE MDL-CODE TO MDS-CODE.
        START MDS-MST KEY IS NOT < MDS-MST-KEY.
        READ MDS-MST NEXT RECORD.
        IF MDS-MST-STATUS = "00" AND MDS-ID = MDL-ID AND
                MDS-CODE = MDL-CODE AND MDS-FROM = MDL-FROM AND MDS-USE = MDL-USE
                PERFORM UNTIL MDS-MST-STATUS NOT = "00" OR
                        MDS-ID NOT = MDL-ID OR MDS-CODE NOT = MDL-CODE OR
                        MDS-FROM NOT = MDL-FROM OR MDS-USE NOT = MDL-USE
                        MOVE MDS-SEQ    TO W-CNT
                        MOVE MDS-DES    TO W-NOTD(W-CNT)
                        READ MDS-MST NEXT RECORD
                END-PERFORM
        END-IF.
        IF W-NOTD-TBL NOT = SPACES THEN
                PERFORM F-DATA-TMP
        END-IF.

 F-DATA-TMP.
        INITIALIZE W-NOTD-TBL-TMP.
        MOVE W-NOTD-TBL TO W-NOTD-TBL-TMP.

        DISPLAY S-MET-TMP.
        MODIFY S-MET-TMP, CURSOR = -1.
        MODIFY S-MET-TMP, ACTION ACTION-COPY.
        COMMIT.
        IF W-SEL = "1" THEN
                MODIFY S-MET-NOT, ACTION ACTION-PASTE
        ELSE
                MODIFY S-MEL-DES, ACTION ACTION-PASTE
        END-IF.


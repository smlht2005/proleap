        OPEN    I-O INQ-TMP.
        IF      INQ-TMP-STATUS = "35" THEN
                OPEN    OUTPUT INQ-TMP
                CLOSE   INQ-TMP
                OPEN    I-O INQ-TMP
        END-IF.
        IF   INQ-TMP-STATUS NOT = "00"
                INITIALIZE W-HRMESCF-DATA W-HRMESCF-DATA2 W-HRMESCF-DATA3
                MOVE "2"  TO W-HRMESCF-PIC-TYPE
                MOVE "3"  TO W-HRMESCF-BUT-TYPE

*COPY    "HR_MET2CF.PRC".
*> 97.5.30 HR_MET2CF.PRC *
 F-HICNTCF-RTN.
        INITIALIZE W-CNTCF-LNK W-MET-CON.
*>START (AICE) 101.09.06 使用舊會診計價或新會診計價
*>      確定為新會診計價時在INITIALIZE W-METCF-PAY W-METCF-PAY2
*>START (AICE) 98.09.24 舊會診計價方式使用新會診計價時造成殘留值
*>      INITIALIZE W-METCF-PAY W-METCF-PAY2.
*>

*>      處理識別 (1.開檔 2.檢核 3.關檔 4.讀取設定值)
        MOVE "2" TO     W-CNTCF-PROCESS-SW.
*>      檢核識別 (F2.會診費)
        MOVE "F2" TO    W-CNTCF-ID.
*>      病歷號碼
        MOVE IPD-PAT-NO TO      W-CNTCF-PAT-NO.
*>      住院序號
        MOVE IPD-NO     TO      W-CNTCF-IPD-NO.
*>      原始住院日 (依序判斷 IPD-ORIGINAL-DT--> IPD-UD-DT--> IPD-DT)
        IF IPD-ORIGINAL-DT > 0
                MOVE IPD-ORIGINAL-DT TO  W-CNTCF-ORG-DATE
        ELSE
                IF IPD-UD-DT > 0
                        MOVE IPD-UD-DT TO W-CNTCF-ORG-DATE
                ELSE
                        IF IPD-DT > 0
                                MOVE IPD-DT TO W-CNTCF-ORG-DATE
                        END-IF
                END-IF
        END-IF.
*>      檢核日期 (醫令/批價只需傳1個檢核日期：處方開立日
*>                申報傳2個檢核日期：申報起日、申報迄日
*>                出院結帳傳2個檢核日期：IPD-DT、IPD-OUT-DT)
        MOVE W-DATE TO  W-CNTCF-CHK-DATE(1).
        CALL "HICNTCF" USING W-CNTCF-LNK ON EXCEPTION CONTINUE
        END-CALL.
        MOVE W-CNTCF-CHK-NUM(1) TO W-MET-CON.
        IF W-CNTCF-10CN-TIMES > 0
*>START         (AICE) 101.09.06 使用舊會診計價或新會診計價
                INITIALIZE W-METCF-PAY W-METCF-PAY2
                IF W-MET-CON >= W-CNTCF-10CN-TIMES
                        INITIALIZE W-HRMESCF-DATA W-HRMESCF-DATA2 W-HRMESCF-DATA3
                        MOVE "3" TO W-HRMESCF-PIC-TYPE
                        MOVE "3" TO W-HRMESCF-BUT-TYPE
                        STRING "此病患" W-CNTCF-CHK-STR-DATE(1) "～" W-CNTCF-CHK-END-DATE(1)
                                DELIMITED BY SIZE INTO W-HRMESCF-NOTE(1)
                        END-STRING
                        STRING "已開立" W-MET-CON "次會診費"
                              DELIMITED BY SIZE INTO W-HRMESCF-NOTE(2)
                        END-STRING
                        IF W-NID-1198(98:1) = "A" OR SPACE
                                STRING "超過上限" W-CNTCF-10CN-TIMES "次!!" DELIMITED BY SIZE
                                        INTO W-HRMESCF-NOTE(3)
                                END-STRING
                        ELSE
                                STRING "超過上限" W-CNTCF-10CN-TIMES "次，將以自費計價!!" DELIMITED BY SIZE
                                        INTO W-HRMESCF-NOTE(3)
                                END-STRING
                        END-IF
                        CALL "HRMESCF" USING W-HRMESCF-DATA W-HRMESCF-DATA2 W-HRMESCF-DATA3
                                ON EXCEPTION CONTINUE
                        END-CALL
*>                      ---(AICE) 98.12.03 ---
*>                      IF W-NID-1198(98:1) NOT = "A"
*>                              MOVE "Y"        TO W-METCF-PAY
*>                              MOVE "Y"        TO W-METCF-PAY2
*>                      END-IF

*>                      ---會同科第二次以上不計價---
                        IF W-RSO-CHK = "N" THEN
                                MOVE "N"        TO W-METCF-PAY
                        ELSE
*>                              ---自費身份不限制會診計價次數---
                                IF W-NID-1198(244:1) = "Y" AND W-INSU-ID NOT = "1" THEN
                                        MOVE "Y"        TO W-METCF-PAY
                                ELSE
                                        EVALUATE W-NID-1198(98:1)
*>                                              ---超次仍計價---
                                                WHEN "A"
                                                        MOVE "Y"        TO W-METCF-PAY
*>                                              ---超次則強制自費---
                                                WHEN "Y"
                                                        MOVE "Y"        TO W-METCF-PAY
                                                        MOVE "Y"        TO W-METCF-PAY2
*>                                              ---超次不計價---
                                                WHEN OTHER
                                                        MOVE "N"        TO W-METCF-PAY
                                        END-EVALUATE
                                END-IF
                        END-IF
                ELSE
*>                      ---會同科第二次以上不計價---
                        IF W-RSO-CHK = "N" THEN
                                MOVE "N"        TO W-METCF-PAY
                        ELSE

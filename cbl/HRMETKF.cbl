*>申請日期
 F-MET-DATE-Aft-Procedure.
        INITIALIZE W-DTCHK-TBL.
        MOVE W-MET-DATE    TO W-DTCHK-TBL1.
        CALL "ZDCHKCF"  USING W-DTCHK-TBL ON EXCEPTION CONTINUE.
        IF W-DTCHK-SW NOT = "Y" THEN
                INITIALIZE W-NOTE
                MOVE "日期不符合，請重新輸入！！"       TO W-NOTE
                PERFORM F-ERR-NOTE
                MOVE 1  TO ACCEPT-CONTROL
        END-IF.
*>      日期檢查(必須大於入院日小於出院日且小於回覆日)
        IF W-MET-DATE < IPD-DT OR
          (W-MET-DT > 0 AND W-MET-DATE > W-MET-DT) OR
          (IPD-OUT-DT > 0 AND W-MET-DATE > IPD-OUT-DT) THEN
                INITIALIZE W-NOTE
                MOVE "通知日期需大於入院日小於出院日，且不可大於回覆日！" TO W-NOTE
                PERFORM F-ERR-NOTE
                MOVE 1  TO ACCEPT-CONTROL
        END-IF.
*>      日期檢查(必須大於等於今天)警告!!
        INITIALIZE W-DTCHK-TBL.
        MOVE W-MET-DATE         TO W-DTCHK-TBL1.
        MOVE "S"                TO W-YYALL-SW.
        CALL "ZDCHKCF" USING W-DTCHK-TBL ON EXCEPTION CONTINUE.
        IF W-DTCHK-SW NOT = "Y" THEN
                INITIALIZE W-NOTE
                MOVE "注意！通知日期小於今天！" TO W-NOTE
                PERFORM F-ERR-NOTE
        END-IF.

        DISPLAY S-MET-DATE.
*>申請時間
